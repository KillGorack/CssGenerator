<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CssGenerator.Views.AppendConflictDialog"
        Width="460"
        Height="360"
        WindowStartupLocation="CenterOwner"
        Title="Classes Already Exist">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <TextBlock TextWrapping="Wrap"
                   Text="These classes already exist in your project. Overwrite them with the imported version, or skip them and keep what you have?"/>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="8">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConflictList"/>
            </ScrollViewer>

        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Content="Cancel"
                    Click="Cancel_Click"/>

            <Button Content="Skip"
                    Click="Skip_Click"/>

            <Button Classes="primary"
                    Content="Overwrite"
                    Click="Overwrite_Click"/>

        </StackPanel>

    </Grid>

</Window>
