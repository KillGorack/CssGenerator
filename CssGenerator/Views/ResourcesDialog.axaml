<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CssGenerator.Views.ResourcesDialog"
        Width="560"
        Height="360"
        WindowStartupLocation="CenterOwner"
        Title="External Resources">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">

        <TextBlock Classes="hint"
                   TextWrapping="Wrap"
                   Text="Paste one &lt;link&gt; or &lt;script&gt; tag per line. These get injected into the page's &lt;head&gt; when you use Open in Browser."/>

        <TextBox x:Name="ResourcesBox"
                 Grid.Row="1"
                 Classes="code"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Content="Cancel"
                    Click="Cancel_Click"/>

            <Button Classes="primary"
                    Content="Done"
                    Click="Done_Click"/>

        </StackPanel>

    </Grid>

</Window>
