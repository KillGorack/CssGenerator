<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CssGenerator.Views.MainWindow"
        Title="CssGenerator"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600">

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="360,*">

        <!-- TOP BAR -->

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="White"
                Padding="20,14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">

                <TextBlock Text="CssGenerator"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="New"
                        Margin="8,0,0,0"
                        Padding="16,7"
                        Click="New_Click"/>

                <Button Grid.Column="2"
                        Content="Open"
                        Margin="8,0,0,0"
                        Padding="16,7"
                        Click="Open_Click"/>

                <Button Grid.Column="3"
                        Classes="accent"
                        Content="Save"
                        Margin="12,0,0,0"
                        Padding="16,7"
                        Click="Save_Click"/>

                <Button Grid.Column="4"
                        Classes="accent"
                        Content="Open in Browser"
                        Margin="8,0,0,0"
                        Padding="16,7"
                        Click="OpenPreview_Click"/>

            </Grid>
        </Border>


        <!-- LEFT CONTROL AREA -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Classes="card"
                Margin="12,12,6,12"
                Padding="16">

            <Grid RowDefinitions="Auto,*,Auto,Auto,*">

                <!-- Classes -->

                <Button Grid.Row="0"
                        Classes="accent"
                        Content="+ Add Class"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,10"
                        Click="AddClass_Click"/>

                <ListBox x:Name="ClassList"
                         Grid.Row="1"
                         SelectionChanged="ClassList_SelectionChanged"/>


                <!-- Selected class -->

                <TextBlock Grid.Row="2"
                           Classes="section-header"
                           Text="SELECTED CLASS"
                           Margin="0,16,0,8"/>

                <TextBox x:Name="ClassNameEditor"
                        Grid.Row="3"
                        PlaceholderText="Class name"/>


                <!-- Properties -->

                <Grid Grid.Row="4"
                      RowDefinitions="Auto,Auto,*">

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,18,0,0">

                        <TextBlock Classes="section-header"
                                   Text="PROPERTIES"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="AddPropertyButton"
                                Grid.Column="1"
                                Classes="accent"
                                Content="Add"/>

                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*,28"
                          ColumnSpacing="6"
                          Margin="0,10,0,6">

                        <TextBlock Classes="hint"
                                   Text="Property"/>

                        <TextBlock Grid.Column="1"
                                   Classes="hint"
                                   Text="Value"/>

                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="PropertyPanel"
                                    Spacing="6"/>

                    </ScrollViewer>

                </Grid>

            </Grid>
        </Border>


        <!-- HTML + CSS -->

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="6,12,12,12"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">


            <!-- HTML -->

            <Border Grid.Column="0"
                    Classes="card"
                    Padding="16">

                <Grid RowDefinitions="Auto,Auto,*">

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,0,0,8">

                        <ComboBox x:Name="SnippetSelector"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Snippet"
                                  SelectionChanged="SnippetSelector_SelectionChanged"/>

                        <Button Grid.Column="1"
                                Classes="accent"
                                Content="Add"
                                MinWidth="120"
                                HorizontalContentAlignment="Center"
                                Margin="6,0,0,0"
                                Click="AddSnippet_Click"/>

                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,10">

                        <TextBox x:Name="SnippetNameEditor"
                                 PlaceholderText="Snippet name"
                                 TextChanged="SnippetNameEditor_TextChanged"/>

                        <Button Grid.Column="1"
                                Classes="accent"
                                Content="Delete"
                                MinWidth="120"
                                HorizontalContentAlignment="Center"
                                Margin="6,0,0,0"
                                Click="DeleteSnippet_Click"/>

                    </Grid>

                    <TextBox x:Name="HtmlEditor"
                             Grid.Row="2"
                             Classes="code"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextChanged="HtmlEditor_TextChanged"/>

                </Grid>

            </Border>


            <!-- CSS -->

            <Border Grid.Column="1"
                    Classes="card"
                    Padding="16">

                <Grid RowDefinitions="Auto,*">

                    <Button x:Name="ExportCssButton"
                            Grid.Row="0"
                            Classes="accent"
                            Content="Export CSS"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,0,0,10"
                            Click="ExportCss_Click"/>

                    <TextBox x:Name="CssEditor"
                             Grid.Row="1"
                             Classes="code"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
