<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CssGenerator.Views.MainWindow"
        Title="CssGenerator"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600">

    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="360,*">

        <!-- MENU BAR -->

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="New" Click="New_Click"/>
                    <MenuItem Header="Open" Click="Open_Click"/>
                    <MenuItem Header="Save" Click="Save_Click"/>
                    <MenuItem Header="Save As" Click="SaveAs_Click"/>
                    <Separator/>
                    <MenuItem Header="Import CSS" Click="ImportCss_Click"/>
                </MenuItem>
                <MenuItem Header="_Export">
                    <MenuItem Header="Export CSS" Click="ExportCss_Click"/>
                    <MenuItem Header="Export Minified CSS" Click="ExportMinifiedCss_Click"/>
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Open in Browser" Click="OpenPreview_Click"/>
                </MenuItem>
            </Menu>
        </Border>


        <!-- LEFT CONTROL AREA -->

        <Border Grid.Row="1"
                Grid.Column="0"
                Classes="card"
                Margin="12,12,6,12"
                Padding="16">

            <Grid RowDefinitions="Auto,*,Auto,Auto,*">

                <!-- Classes -->

                <Button Grid.Row="0"
                        Classes="primary"
                        Content="+ Add Class"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,0,0,10"
                        Click="AddClass_Click"/>

                <Grid Grid.Row="1"
                      RowDefinitions="Auto,*">

                    <TextBox x:Name="ClassSearchBox"
                             Grid.Row="0"
                             Margin="0,0,0,8"
                             PlaceholderText="Search classes (Enter)"
                             KeyDown="ClassSearchBox_KeyDown"/>

                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="8">

                        <ListBox x:Name="ClassList"
                                 SelectionChanged="ClassList_SelectionChanged"/>

                    </Border>

                </Grid>


                <!-- Selected class -->

                <Separator Grid.Row="2"
                           Margin="0,10"/>

                <TextBox x:Name="ClassNameEditor"
                        Grid.Row="3"
                        PlaceholderText="Class name"/>


                <!-- Properties -->

                <Grid Grid.Row="4"
                      RowDefinitions="Auto,*">

                    <Button x:Name="AddPropertyButton"
                            Classes="primary"
                            Content="+ Add Property"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Margin="0,10,0,10"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="PropertyPanel"
                                    Spacing="6"/>

                    </ScrollViewer>

                </Grid>

            </Grid>
        </Border>


        <!-- HTML + CSS -->

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="6,12,12,12"
              ColumnDefinitions="*,*"
              ColumnSpacing="12">


            <!-- HTML -->

            <Border Grid.Column="0"
                    Classes="card"
                    Padding="16">

                <Grid RowDefinitions="Auto,Auto,*">

                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,0,0,8">

                        <ComboBox x:Name="SnippetSelector"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Snippet"
                                  SelectionChanged="SnippetSelector_SelectionChanged"/>

                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="Add"
                                MinWidth="120"
                                HorizontalContentAlignment="Center"
                                Margin="6,0,0,0"
                                Click="AddSnippet_Click"/>

                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,10">

                        <TextBox x:Name="SnippetNameEditor"
                                 PlaceholderText="Snippet name"
                                 TextChanged="SnippetNameEditor_TextChanged"/>

                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="Delete"
                                MinWidth="120"
                                HorizontalContentAlignment="Center"
                                Margin="6,0,0,0"
                                Click="DeleteSnippet_Click"/>

                    </Grid>

                    <TextBox x:Name="HtmlEditor"
                             Grid.Row="2"
                             Classes="code"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             TextChanged="HtmlEditor_TextChanged"/>

                </Grid>

            </Border>


            <!-- CSS -->

            <Border Grid.Column="1"
                    Classes="card"
                    Padding="16">

                <Grid RowDefinitions="*">

                    <TextBox x:Name="CssEditor"
                             Grid.Row="0"
                             Classes="code"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
